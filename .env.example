# ============================================================
# EXEMPLE DE FICHIER .env
# Copiez ce fichier vers .env et remplissez les valeurs
# ============================================================

APP_ENV=production

# Base de données
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=store_crm
DB_CHARSET=utf8mb4

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@yourstore.com
SMTP_FROM_NAME="Store CRM"

# API Keys
NEWS_API_KEY=votre-cle-api-newsapi

# Application
SITE_NAME="Store CRM"
BASE_URL=http://localhost/u/
ADMIN_EMAIL=admin@example.com